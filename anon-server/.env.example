# ANON// backend — environment variables

PORT=4000
CLIENT_ORIGIN=*

# Admin dashboard token (visit /admin?token=THIS_VALUE)
ADMIN_TOKEN=change-me-to-a-long-random-string

# HMAC secret for IP hashing (Rule 3(1)(h) compliance)
IP_HASH_SECRET=change-me-to-another-long-random-string

# Message limits
MAX_MSG_LENGTH=1000
RATE_MSG_PER_10S=15
RATE_INVITE_PER_MIN=5
RATE_ROOM_CREATE_PER_MIN=3
