# ANON// backend — environment variables

PORT=4000
# Local development default. In production, set the exact HTTPS frontend origin(s).
CLIENT_ORIGIN=http://localhost:3000
# Public backend origin (also used to access the admin dashboard). Required in production.
SERVER_ORIGIN=http://localhost:4000

# Enable only if the production ingress proxy overwrites/sanitizes X-Forwarded-For.
TRUST_PROXY=false

# Admin dashboard token (enter it on /admin; never put it in a URL).
# Use a unique random secret of at least 32 characters in production.
ADMIN_TOKEN=change-me-to-a-long-random-string

# HMAC secret used to pseudonymize connection identifiers; not a legal-compliance guarantee.
# Use a unique random secret of at least 32 characters in production.
IP_HASH_SECRET=change-me-to-another-long-random-string

# Message limits
MAX_MSG_LENGTH=1000
RATE_MSG_PER_10S=15
RATE_INVITE_PER_MIN=5
RATE_ROOM_CREATE_PER_MIN=3
